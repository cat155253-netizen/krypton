# K-Tron / Krypton server configuration
#
# Copy this file to .env and fill in your values. The .env file is git-ignored
# and must NEVER be committed or shared.

# --- AI chat (optional) ---
# Required if you want K-Tron chat to answer. Get a key from your provider
# (e.g. OpenRouter https://openrouter.ai/keys or OpenAI).
OPENAI_API_KEY=

# --- Application confirmation email ---
# EASIEST: Gmail SMTP. Turn on 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords (name it "Krypton"), paste the 16-char
# code below (spaces optional). 500 emails/day, free, sends from your own Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=mrcat4005@gmail.com
SMTP_PASS=

# Alternatives (only if SMTP not used):
# BREVO_API_KEY=            # Brevo free: verify your email as sender, no domain
# RESEND_API_KEY=           # Resend: needs a verified domain
# Priority: SMTP > Brevo > Resend.

# The "from" sender shown to applicants. Verify it in whichever provider you use.
FROM_EMAIL=onboarding@krypton.studio

# Display name shown as the sender. Defaults to "K-Tron".
FROM_NAME=K-Tron

# Optional overrides
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# KTRON_MODEL=openrouter/auto
#   openrouter/auto = OpenRouter auto-routes to the best available flagship model.
#   Anything listenable on OpenRouter works, e.g. openai/gpt-5, anthropic/claude-opus-4.
# KTRON_MAX_TOKENS=1400
# APPLY_DELAY_MS=3000
# PORT=4173
# HOST=127.0.0.1

# --- Admin dashboard (admin.html at /admin) ---
# The password for the KRYPTON Control Room. REQUIRED to log in.
# On Render, set this as a secret env var in the dashboard.
ADMIN_PASSWORD=

# --- Database ---
# Optional. Without it the server uses an in-memory store (data is lost on restart).
# On Render this is injected automatically by the Postgres blueprint.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- Session ---
# How long an admin login lasts, in milliseconds. Default 7 days.
# SESSION_TTL_MS=604800000
